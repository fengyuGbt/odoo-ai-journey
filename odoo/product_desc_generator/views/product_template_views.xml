<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 产品表单加 "AI 生成描述" 按钮（插在报价描述 group 内，字段旁） -->
    <record id="product_template_ai_desc_button" model="ir.ui.view">
        <field name="name">product.template.ai.desc.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='description']" position="inside">
                <button name="action_generate_desc" type="object" string="AI 生成描述"
                        class="oe_link" icon="fa-magic"/>
            </xpath>
        </field>
    </record>
</odoo>
